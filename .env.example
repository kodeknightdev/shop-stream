# Copy to .env and adjust. Never commit the real .env.

# --- shared ---------------------------------------------------------------
# shared HS256 key, at least 32 chars
JWT_SIGNING_KEY=replace-with-a-long-random-string-at-least-32-chars

# --- demo data (local only) ---------------------------------------------
# password for the seeded demo accounts - local demo data, not a real credential
SEED_DEMO_PASSWORD=Demo@12345

# --- postgres -------------------------------------------------------------
POSTGRES_USER=shopstream
POSTGRES_PASSWORD=shopstream

# --- payments -------------------------------------------------------------
# Stripe test keys only. Leave empty to use the mock provider.
# e.g. STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- inventory ------------------------------------------------------------
# How long stock stays reserved waiting for payment
RESERVATION_TTL_SECONDS=900

# --- images ---------------------------------------------------------------
IMAGE_TAG=local
# override if you pull through a mirror
KAFKA_IMAGE=bitnami/kafka:3.5.1

# --- azure (CI/CD placeholders, not used locally) -------------------------
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
ACR_LOGIN_SERVER=shopstreamacr.azurecr.io
